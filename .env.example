# Copy this file to ".env" for local builds (never commit .env).
# On Vercel, set the same two variables in Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "Data API") → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → the PUBLIC key:
#   "anon public" (legacy JWT key) or "publishable" (sb_publishable_…).
# NEVER put the service_role / secret key (sb_secret_…) here: the build will refuse it.
SUPABASE_ANON_KEY=
